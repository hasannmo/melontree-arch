#!/usr/bin/env python3
import sys, os, time, signal, subprocess, datetime

SOUND = os.path.expanduser("~/.local/share/alarm/cockpit_alarm.mp3")
SELF = os.path.abspath(__file__)

def sh(*cmd):
    return subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def max_volume():
    # PipeWire (wpctl) first, PulseAudio (pactl) fallback
    if sh("wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "0").returncode == 0:
        sh("wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", "1.0")
    else:
        sh("pactl", "set-sink-mute", "@DEFAULT_SINK@", "0")
        sh("pactl", "set-sink-volume", "@DEFAULT_SINK@", "100%")

def wait_until(hhmm):
    now = datetime.datetime.now()
    h, m = map(int, hhmm.split(":"))
    target = now.replace(hour=h, minute=m, second=0, microsecond=0)
    if target <= now:
        target += datetime.timedelta(days=1)
    time.sleep((target - now).total_seconds())

def prompt_mode(mpv_pid):
    # runs inside kitty: ignore Ctrl+C, loop until sudo password is correct
    signal.signal(signal.SIGINT, signal.SIG_IGN)
    signal.signal(signal.SIGTSTP, signal.SIG_IGN)
    print("ALARM — enter sudo password to stop")
    while True:
        max_volume()
        if subprocess.run(["sudo", "-k", "-v"]).returncode == 0:
            break
    sh("sudo", "-k")
    try:
        os.kill(int(mpv_pid), signal.SIGTERM)
    except ProcessLookupError:
        pass

def ring(label):
    max_volume()
    sh("notify-send", "-u", "critical", "Alarm", label)
    mpv = subprocess.Popen(
        ["mpv", "--no-video", "--really-quiet", "--loop=inf", SOUND],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    )
    subprocess.run(["kitty", "--class", "alarm", "-e", sys.executable, SELF, "--stop", str(mpv.pid)])
    mpv.wait()

if __name__ == "__main__":
    if len(sys.argv) >= 3 and sys.argv[1] == "--stop":
        prompt_mode(sys.argv[2])
        sys.exit(0)
    if len(sys.argv) < 2:
        sys.exit("usage: alarm HH:MM [label]")
    label = " ".join(sys.argv[2:]) or "Wake up"
    wait_until(sys.argv[1])
    ring(label)
