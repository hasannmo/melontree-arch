{
    // ==========================================
    // MELONTREE - ASHEN REVERIE VISUAL IDENTITY
    // Reference: ~/melontree_co.md
    // ==========================================

    // Layout & Core UI Settings
    "workbench.secondarySideBar.defaultVisibility": "visible",
    "claudeCode.preferredLocation": "panel",
    "claudeCode.hideOnboarding": true,
    "terminal.integrated.initialHint": false,
    "workbench.editor.empty.hint": "hidden",
    "workbench.tips.enabled": false,
    "workbench.startupEditor": "none",
    "window.menuBarVisibility": "compact",
    "window.dialogStyle": "custom",
    "window.titleBarStyle": "custom",

    // Typography (JetBrains Mono Nerd Font from system)
    "editor.fontFamily": "'JetBrainsMono Nerd Font', 'JetBrains Mono', monospace",
    "editor.fontSize": 13,
    "editor.lineHeight": 1.6,
    "editor.fontLigatures": true,
    "editor.fontWeight": "400",
    "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font', 'JetBrains Mono', monospace",
    "terminal.integrated.fontSize": 12,

    // Editor Polish & Minimal Cleanliness
    "editor.cursorBlinking": "smooth",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.cursorStyle": "line",
    "editor.cursorWidth": 2,
    "editor.smoothScrolling": true,
    "editor.renderWhitespace": "selection",
    "editor.renderLineHighlight": "gutter",
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": "active",
    "editor.guides.indentation": true,

    // Minimal Activity Bar / Breadcrumbs
    "workbench.tree.indent": 14,
    "workbench.tree.renderIndentGuides": "always",
    "breadcrumbs.enabled": true,

    // Workbench Color Customizations (Ashen Reverie Palette)
    "workbench.colorCustomizations": {
        // Foundation & Base
        "focusBorder": "#C85B4D",
        "foreground": "#C8BFB5",
        "widget.shadow": "#00000040",
        "selection.background": "#514B4380",
        "descriptionForeground": "#A89C91",
        "errorForeground": "#E98570",

        // Title Bar & Window
        "titleBar.activeBackground": "#1B1A18",
        "titleBar.activeForeground": "#E0D8D0",
        "titleBar.inactiveBackground": "#1B1A18",
        "titleBar.inactiveForeground": "#514B43",
        "titleBar.border": "#292724",

        // Activity Bar
        "activityBar.background": "#1B1A18",
        "activityBar.foreground": "#F4EEE5",
        "activityBar.inactiveForeground": "#514B43",
        "activityBar.border": "#292724",
        "activityBarBadge.background": "#C85B4D",
        "activityBarBadge.foreground": "#F4EEE5",

        // Sidebar
        "sideBar.background": "#1B1A18",
        "sideBar.foreground": "#C8BFB5",
        "sideBar.border": "#292724",
        "sideBarTitle.foreground": "#F4EEE5",
        "sideBarSectionHeader.background": "#292724",
        "sideBarSectionHeader.foreground": "#E0D8D0",
        "sideBarSectionHeader.border": "#3B3731",

        // Secondary Side Bar (Claude Code / Utilities)
        "sideBar.secondary.background": "#1B1A18",
        "sideBar.secondary.border": "#292724",

        // Editor Surface
        "editor.background": "#1B1A18",
        "editor.foreground": "#F4EEE5",
        "editorLineNumber.foreground": "#3B3731",
        "editorLineNumber.activeForeground": "#C2A15B",
        "editorCursor.foreground": "#E98570",
        "editor.selectionBackground": "#3B373180",
        "editor.selectionHighlightBackground": "#3B373150",
        "editor.wordHighlightBackground": "#28383B80",
        "editor.wordHighlightStrongBackground": "#3F626580",
        "editor.findMatchBackground": "#632B27a0",
        "editor.findMatchHighlightBackground": "#69552D80",
        "editor.lineHighlightBackground": "#29272440",
        "editor.lineHighlightBorder": "#00000000",
        "editorLink.activeForeground": "#91B5B5",

        // Editor Tabs & Groups
        "editorGroupHeader.tabsBackground": "#1B1A18",
        "editorGroupHeader.tabsBorder": "#292724",
        "editorGroup.border": "#292724",
        "tab.activeBackground": "#292724",
        "tab.activeForeground": "#F4EEE5",
        "tab.activeBorderTop": "#C85B4D",
        "tab.inactiveBackground": "#1B1A18",
        "tab.inactiveForeground": "#A89C91",
        "tab.border": "#292724",
        "tab.hoverBackground": "#29272480",

        // Status Bar (Subtle Charcoal with Ivory/Vermilion indicators)
        "statusBar.background": "#1B1A18",
        "statusBar.foreground": "#A89C91",
        "statusBar.border": "#292724",
        "statusBar.debuggingBackground": "#632B27",
        "statusBar.debuggingForeground": "#F4EEE5",
        "statusBar.noFolderBackground": "#1B1A18",
        "statusBarItem.hoverBackground": "#3B3731",
        "statusBarItem.remoteBackground": "#292724",
        "statusBarItem.remoteForeground": "#62878A",

        // Panel (Terminal, Output, Problems)
        "panel.background": "#1B1A18",
        "panel.border": "#292724",
        "panelTitle.activeBorder": "#C85B4D",
        "panelTitle.activeForeground": "#F4EEE5",
        "panelTitle.inactiveForeground": "#514B43",

        // Terminal (Synthetic Ruin / Technical influence)
        "terminal.background": "#1B1A18",
        "terminal.foreground": "#E0D8D0",
        "terminal.ansiBlack": "#1B1A18",
        "terminal.ansiRed": "#C85B4D",
        "terminal.ansiGreen": "#7F9478",
        "terminal.ansiYellow": "#C2A15B",
        "terminal.ansiBlue": "#62878A",
        "terminal.ansiMagenta": "#9B86A0",
        "terminal.ansiCyan": "#91B5B5",
        "terminal.ansiWhite": "#E0D8D0",
        "terminal.ansiBrightBlack": "#514B43",
        "terminal.ansiBrightRed": "#E98570",
        "terminal.ansiBrightGreen": "#A9B99B",
        "terminal.ansiBrightYellow": "#E2C982",
        "terminal.ansiBrightBlue": "#91B5B5",
        "terminal.ansiBrightMagenta": "#C2AEC5",
        "terminal.ansiBrightCyan": "#B4D5D5",
        "terminal.ansiBrightWhite": "#F4EEE5",

        // Lists, Trees, & Menus
        "list.activeSelectionBackground": "#292724",
        "list.activeSelectionForeground": "#F4EEE5",
        "list.inactiveSelectionBackground": "#29272480",
        "list.inactiveSelectionForeground": "#E0D8D0",
        "list.hoverBackground": "#29272460",
        "list.hoverForeground": "#F4EEE5",
        "list.highlightForeground": "#E98570",
        "menu.background": "#292724",
        "menu.foreground": "#E0D8D0",
        "menu.selectionBackground": "#3B3731",
        "menu.selectionForeground": "#F4EEE5",
        "menu.border": "#3B3731",

        // Inputs, Badges & Breadcrumbs
        "input.background": "#292724",
        "input.foreground": "#F4EEE5",
        "input.border": "#3B3731",
        "input.placeholderForeground": "#514B43",
        "badge.background": "#C85B4D",
        "badge.foreground": "#F4EEE5",
        "progressBar.background": "#C85B4D",
        "scrollbarSlider.background": "#3B373140",
        "scrollbarSlider.hoverBackground": "#514B4360",
        "scrollbarSlider.activeBackground": "#514B43a0",
        "breadcrumbs.foreground": "#A89C91",
        "breadcrumbs.focusForeground": "#F4EEE5",
        "breadcrumbs.activeSelectionForeground": "#E98570"
    },

    // Token Syntax Highlighting (Ashen Reverie Palette)
    "editor.tokenColorCustomizations": {
        "comments": "#514B43",
        "keywords": "#C85B4D",
        "functions": "#62878A",
        "strings": "#7F9478",
        "types": "#C2A15B",
        "variables": "#E0D8D0",
        "numbers": "#C9825F",
        "textMateRules": [
            {
                "scope": ["storage.type", "storage.modifier"],
                "settings": { "foreground": "#E98570" }
            },
            {
                "scope": ["constant.language", "constant.numeric"],
                "settings": { "foreground": "#C9825F" }
            },
            {
                "scope": ["variable.parameter", "variable.other.readwrite"],
                "settings": { "foreground": "#E0D8D0" }
            },
            {
                "scope": ["entity.name.tag", "entity.other.attribute-name"],
                "settings": { "foreground": "#62878A" }
            },
            {
                "scope": ["punctuation", "meta.brace"],
                "settings": { "foreground": "#A89C91" }
            },
            {
                "scope": ["support.type", "support.class"],
                "settings": { "foreground": "#91B5B5" }
            },
            {
                "scope": ["comment"],
                "settings": { "fontStyle": "italic", "foreground": "#686F76" }
            }
        ]
    }
}
