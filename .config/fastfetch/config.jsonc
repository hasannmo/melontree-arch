{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
"logo": {
"type": "small",
"color": {
"1": "38;5;173",  // Vermilion Glow (signature accent, glow variant)
"2": "38;5;131"   // Ivory Light (neutral highlight)
//"3": "38;5;239"   // Charcoal Glow (muted shadow/outline)
    }
  },
"display": {
"separator": " → "
  },
"modules": [
    {
"type": "title",
"color": { "user": "38;5;131", "at": "38;5;239", "host": "38;5;251" }
    },
"separator",
    { "type": "os", "key": "  OS", "keyColor": "38;5;59" },
    { "type": "kernel", "key": "  Kernel", "keyColor": "38;5;59" },
    { "type": "uptime", "key": "  Uptime", "keyColor": "38;5;59" },
    { "type": "packages", "key": "  Packages", "keyColor": "38;5;59" },
    { "type": "shell", "key": "  Shell", "keyColor": "38;5;59" },
    { "type": "wm", "key": "  WM", "keyColor": "38;5;59" },
    { "type": "terminal", "key": "  Terminal", "keyColor": "38;5;59" },
    { "type": "cpu", "key": "  CPU", "keyColor": "38;5;66" },
    { "type": "gpu", "key": "  GPU", "keyColor": "38;5;66" },
    { "type": "memory", "key": "  Memory", "keyColor": "38;5;66" },
"break",
    { "type": "colors", "paddingLeft": 2 }
  ]
}